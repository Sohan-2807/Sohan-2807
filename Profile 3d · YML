# Save as: .github/workflows/profile-3d-contrib.yml
# Generates the 3D contribution calendar into ./profile-3d-contrib/
name: GitHub Profile 3D Contrib

on:
  schedule:
    - cron: "0 18 * * *"     # daily, 11:30 PM IST
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    name: Generate 3D Contribution Graph

    steps:
      - uses: actions/checkout@v4

      - name: GitHub-Profile-3D-Contrib
        uses: yoshi389111/github-profile-3d-contrib@v0.9.3
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          USERNAME: Sohan-2807

      - name: Commit & Push 3D SVG
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"
          git add -A
          git diff --staged --quiet || git commit -m "Update 3D contribution graph"
          git push
